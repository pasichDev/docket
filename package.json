{
  "name": "@pasichdev/todo-mcp",
  "version": "2.0.5",
  "description": "A shared TODO/backlog MCP server with a web UI, agent claim/release tracking, and encrypted local storage.",
  "license": "MIT",
  "author": "pasichDev",
  "homepage": "https://github.com/pasichDev/todo-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pasichDev/todo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/pasichDev/todo-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "todo",
    "todo-list",
    "task-manager",
    "backlog",
    "claude",
    "claude-code",
    "claude-desktop",
    "ai-agent",
    "productivity",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "todo-mcp": "dist/launcher.js",
    "todo-mcp-setup": "dist/setup.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pasichDev/todo-mcp",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "web": "node dist/web.js",
    "stats": "node dist/stats.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test dist/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.0"
  }
}
